# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> Database, and Project Settings -> API).
# Never commit .env — it is already gitignored.

# Postgres — pooled connection (Transaction mode, port 6543), used at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Postgres — direct connection (port 5432), used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase API (Project Settings -> API). The anon key is safe for the browser;
# the service role key must NEVER be exposed to the client.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# Optional, local testing only — shortens the auto-checkout limit (normally
# 11h) so you don't have to wait 11 hours to see it fire. Leave unset in
# production. Restart `next dev` after changing this.
# NEXT_PUBLIC_AUTO_CHECKOUT_MINUTES="232"
