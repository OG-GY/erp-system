// Prisma schema for the Employee Management System.
// MVP scope: see docs/mvp-scope.md. Entities below cover checklist §1-10 (employees,
// accounts/roles, attendance, time tracking, leave, projects/tasks) plus payroll basics
// and audit logging.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer/Supavisor) connection — used at runtime.
  url       = env("DATABASE_URL")
  // Direct connection — required by `prisma migrate` because the pooler
  // doesn't support the prepared statements migrations rely on.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Accounts, roles, org structure
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  HR_MANAGER
  MANAGER
  PROJECT_MANAGER
  CALL_CALLER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERN
  CONTRACT
}

enum SalaryType {
  FIXED
  COMMISSION
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  headId    String?    @unique
  head      Employee?  @relation("DepartmentHead", fields: [headId], references: [id])
  employees Employee[] @relation("DepartmentMembers")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// A team is just a named group — no required department, no designated
// "lead" field baked into the structure. Who does what within a team is
// just a free-text label on their membership (TeamMembership.role), not a
// structural hierarchy. An employee can belong to any number of teams.
model Team {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  memberships TeamMembership[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model TeamMembership {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  role       String   @default("Member")
  // Gates real permissions (who can manage this team's membership) —
  // deliberately separate from the free-text `role` label above, which
  // stays purely cosmetic and is never checked for authorization.
  isLead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([teamId, employeeId])
  @@index([employeeId])
}

// Supabase Auth owns credentials (auth.users). This table mirrors the app-level
// identity: id == Supabase auth user id. Never store passwords here.
model Employee {
  id                    String    @id // Supabase auth.users.id
  employeeNumber        String    @unique
  fullName              String
  officialEmail         String    @unique
  // --- Self-service fields: the employee fills these in from /profile. ---
  personalEmail         String?
  phone                 String?
  profilePictureUrl     String?
  dateOfBirth           DateTime? @db.Date
  gender                String?
  residentialAddress    String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // --- Admin/HR-only fields: never writable from the self-service profile action. ---
  role             Role             @default(EMPLOYEE)
  designation      String?
  idCardNumber     String?
  employmentStatus EmploymentStatus @default(ACTIVE)
  employmentType   EmploymentType   @default(FULL_TIME)
  joiningDate      DateTime
  terminationDate  DateTime?

  // Compensation — exactly one of these two applies, based on salaryType.
  // Both nullable: unset until an admin configures it.
  salaryType           SalaryType?
  baseSalary           Decimal?    @db.Decimal(12, 2)
  commissionPerProject Decimal?    @db.Decimal(12, 2)

  departmentId String?
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])
  managerId    String?
  manager      Employee?   @relation("ManagerReports", fields: [managerId], references: [id])
  reports      Employee[]  @relation("ManagerReports")

  departmentHeadOf Department? @relation("DepartmentHead")

  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]     @relation("LeaveApplicant")
  leaveApprovals    LeaveRequest[]     @relation("LeaveApprover")
  timeEntries       TimeEntry[]
  timesheets        Timesheet[]
  projectMembers    ProjectMember[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  payslips          Payslip[]
  auditLogs         AuditLog[]
  teamMemberships   TeamMembership[]
  interviewNotes    InterviewNote[]

  leadsOwned           Lead[]            @relation("LeadOwner")
  leadsCreated         Lead[]            @relation("LeadCreator")
  leadHandoffsReceived Lead[]            @relation("LeadHandoffRecipient")
  leadStatusEvents     LeadStatusEvent[]
  callAttempts         CallAttempt[]
  followUpsAssigned    FollowUp[]        @relation("FollowUpAssignee")

  coldLeadsOwned ColdLead[]
  coldCallLogs   ColdCallLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([managerId])
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

model AttendanceRecord {
  id         String            @id @default(cuid())
  employeeId String
  employee   Employee          @relation(fields: [employeeId], references: [id])
  date       DateTime          @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus  @default(PRESENT)
  notes      String?
  standup    String?
  breaks     AttendanceBreak[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model AttendanceBreak {
  id                 String           @id @default(cuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id])
  startedAt          DateTime
  endedAt            DateTime?
  createdAt          DateTime         @default(now())

  @@index([attendanceRecordId])
}

// ---------------------------------------------------------------------------
// Leave management
// ---------------------------------------------------------------------------

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  UNPAID
  EMERGENCY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id              String      @id @default(cuid())
  employeeId      String
  employee        Employee    @relation("LeaveApplicant", fields: [employeeId], references: [id])
  leaveType       LeaveType
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  daysCount       Decimal     @db.Decimal(4, 1)
  reason          String
  status          LeaveStatus @default(PENDING)
  approverId      String?
  approver        Employee?   @relation("LeaveApprover", fields: [approverId], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Recruitment / interviews
// ---------------------------------------------------------------------------

enum CandidateStatus {
  APPLIED
  SCHEDULED
  IN_PROGRESS
  ON_HOLD
  APPROVED
  OFFER_SENT
  REJECTED
}

model Candidate {
  id            String          @id @default(cuid())
  fullName      String
  position      String
  email         String?
  phone         String?
  status        CandidateStatus @default(APPLIED)
  interviewDate DateTime?       @db.Date
  // Storage object path, not a public URL — the "candidate-cvs" bucket is
  // private (CVs are personal documents), so viewing it means generating a
  // short-lived signed URL server-side from this path.
  cvPath        String?
  notes         InterviewNote[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
}

model InterviewNote {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  authorId    String
  author      Employee  @relation(fields: [authorId], references: [id])
  note        String
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

// ---------------------------------------------------------------------------
// Projects and tasks
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus   @default(PLANNING)
  startDate   DateTime?       @db.Date
  endDate     DateTime?       @db.Date
  members     ProjectMember[]
  tasks       Task[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  // A boolean, not a free-text label — this gates real permissions (add/
  // remove members, create tasks, edit the project), unlike
  // TeamMembership.role which is purely a cosmetic display string.
  isManager  Boolean  @default(false)
  addedAt    DateTime @default(now())

  @@unique([projectId, employeeId])
}

model Task {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id])
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String?
  assignee       Employee?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById    String
  createdBy      Employee     @relation("TaskCreator", fields: [createdById], references: [id])
  dueDate        DateTime?    @db.Date
  estimatedHours Decimal?     @db.Decimal(6, 2)
  timeEntries    TimeEntry[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Time tracking
// ---------------------------------------------------------------------------

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model TimeEntry {
  id              String     @id @default(cuid())
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id])
  taskId          String?
  task            Task?      @relation(fields: [taskId], references: [id])
  timesheetId     String?
  timesheet       Timesheet? @relation(fields: [timesheetId], references: [id])
  date            DateTime   @db.Date
  durationMinutes Int
  description     String?
  billable        Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([employeeId, date])
  @@index([taskId])
}

model Timesheet {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id])
  periodStart DateTime        @db.Date
  periodEnd   DateTime        @db.Date
  status      TimesheetStatus @default(DRAFT)
  entries     TimeEntry[]
  submittedAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([employeeId, periodStart, periodEnd])
}

// ---------------------------------------------------------------------------
// Payroll (minimal — expand once local tax rules are confirmed)
// ---------------------------------------------------------------------------

enum PayslipStatus {
  DRAFT
  APPROVED
  PAID
}

model Payslip {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id])
  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  basicSalary Decimal       @db.Decimal(12, 2)
  allowances  Decimal       @default(0) @db.Decimal(12, 2)
  deductions  Decimal       @default(0) @db.Decimal(12, 2)
  netSalary   Decimal       @db.Decimal(12, 2)
  status      PayslipStatus @default(DRAFT)
  paidAt      DateTime?
  pdfUrl      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([employeeId, periodStart, periodEnd])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id            String    @id @default(cuid())
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Call Caller / lead management
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  READY_TO_CALL
  CONTACTED
  QUALIFIED
  MEETING_BOOKED
  PROPOSAL_SENT
  WON
  LOST
  DISQUALIFIED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum InterestLevel {
  LOW
  MEDIUM
  HIGH
}

// What happened on a call attempt. Distinct from LeadStatus: an outcome
// describes one attempt, a status describes the lead's overall pipeline
// position — logging a call never changes status by itself (see
// updateCallSession in lib/actions/calls.ts).
enum CallOutcome {
  NO_ANSWER
  BUSY
  VOICEMAIL
  GATEKEEPER
  DECISION_MAKER_REACHED
  INTERESTED
  CALLBACK_REQUESTED
  MEETING_BOOKED
  NOT_INTERESTED
  INVALID_NUMBER
  DO_NOT_CALL
}

enum HandoffStatus {
  NONE
  PENDING
  SENT
  ACCEPTED
  COMPLETED
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// A lead's WhatsApp-reachability problem, tracked separately from its main
// pipeline status (LeadStatus) — a lead can be QUALIFIED in the pipeline and
// still need a plain SIM/local call because WhatsApp couldn't reach them
// (no internet on their end). Null means this never came up for the lead.
enum SimCallStatus {
  NEEDS_SIM_CALL
  ATTEMPTED
  RESOLVED
  UNREACHABLE
}

model Lead {
  id                String  @id @default(cuid())
  businessName      String
  industry          String?
  city              String?
  area              String?
  businessOwnerName String?
  contactName       String?
  contactRole       String?
  phone             String?
  whatsapp          String?
  email             String?
  website           String?
  source            String?
  notes             String?

  // Prospecting context — what the caller found before/while reaching out.
  onlinePresence  String?
  identifiedNeeds String?
  priority        LeadPriority?

  status             LeadStatus @default(NEW)
  disqualifiedReason String?
  lostReason         String?
  dealValue          Decimal?   @db.Decimal(12, 2)

  // Enforced server-side in startCallSession, not just hidden in the UI —
  // see lib/actions/calls.ts.
  doNotCall       Boolean @default(false)
  doNotCallReason String?

  // See SimCallStatus — null until a caller flags the lead as unreachable
  // on WhatsApp.
  simCallStatus SimCallStatus?
  simCallNote   String?

  ownerId     String?
  owner       Employee? @relation("LeadOwner", fields: [ownerId], references: [id])
  createdById String
  createdBy   Employee  @relation("LeadCreator", fields: [createdById], references: [id])

  nextFollowUpDate DateTime? @db.Date
  nextAction       String?

  // Founder handoff — preserved context for a qualified lead, not a repeat
  // of the full call history (that's already on the lead via `calls`).
  handoffStatus  HandoffStatus @default(NONE)
  handoffContext String?
  handoffAt      DateTime?
  handoffToId    String?
  handoffTo      Employee?     @relation("LeadHandoffRecipient", fields: [handoffToId], references: [id])
  meetingHeldAt  DateTime?

  calls        CallAttempt[]
  followUps    FollowUp[]
  statusEvents LeadStatusEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([nextFollowUpDate])
  @@index([phone])
  @@index([simCallStatus])
}

/**
 * One row per status change — the lead's pipeline history survives even as
 * `Lead.status` itself is overwritten. Also where disqualify/lost reasons
 * and qualification/meeting/won timestamps are derived from for metrics,
 * rather than trusting a point-in-time snapshot.
 */
model LeadStatusEvent {
  id          String      @id @default(cuid())
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id])
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  reason      String?
  changedById String
  changedBy   Employee    @relation(fields: [changedById], references: [id])
  createdAt   DateTime    @default(now())

  @@index([leadId])
  @@index([toStatus])
}

/**
 * A manually-tracked call session, not a real telephony record — the caller
 * dials on a physical phone, and this just logs start/end/outcome. A row is
 * created the moment a session starts (startedAt set, endedAt null is "in
 * progress"); ending it fills in the rest. Never auto-created or inferred.
 */
model CallAttempt {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id])
  callerId      String
  caller        Employee @relation(fields: [callerId], references: [id])
  attemptNumber Int

  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?

  outcome              CallOutcome?
  decisionMakerReached Boolean        @default(false)
  interestLevel        InterestLevel?
  painPoints           String?
  objections           String?
  notes                String?
  nextAction           String?
  nextFollowUpDate     DateTime?      @db.Date
  meetingDetails       String?
  whatsappConsent      Boolean?

  followUps FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([callerId])
  @@index([leadId, callerId, endedAt])
}

model FollowUp {
  id            String       @id @default(cuid())
  leadId        String
  lead          Lead         @relation(fields: [leadId], references: [id])
  callAttemptId String?
  callAttempt   CallAttempt? @relation(fields: [callAttemptId], references: [id])

  dueDate     DateTime       @db.Date
  action      String
  status      FollowUpStatus @default(SCHEDULED)
  completedAt DateTime?

  assignedToId String
  assignedTo   Employee @relation("FollowUpAssignee", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([dueDate])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Cold calling — self-sourced prospecting, open to every role
// ---------------------------------------------------------------------------

// Where the person found the business. Separate from the free-form
// Lead.source on purpose: cold-calling stats group by it.
enum ColdLeadSource {
  GOOGLE_MAPS
  REFERENCE
  SOCIAL_MEDIA
  WALK_IN
  OTHER
}

// A cold lead's funnel position. Logging a call sets it directly (the call's
// outcome IS the new status), unlike the main pipeline where a CallOutcome
// and a LeadStatus are tracked separately. CONVERTED means it was moved into
// the main Leads pipeline (see convertColdLead in lib/actions/coldCalling.ts).
enum ColdLeadStatus {
  NEW
  NO_ANSWER
  CALLBACK
  SEND_DETAILS
  DETAILS_SENT
  FOLLOW_UP_LATER
  INTERESTED
  CONVERTED
  HAS_TEAM
  NOT_INTERESTED
  WRONG_NUMBER
}

/**
 * A business someone found and is cold-calling themselves. Deliberately its
 * own table, not a Lead: most of these die on the first call, and the main
 * Leads pipeline (handoffs, call sessions, owner pool) is restricted to
 * admins/callers. An interested one is promoted to a real Lead.
 */
model ColdLead {
  id           String         @id @default(cuid())
  businessName String
  category     String?
  city         String?
  area         String?
  contactName  String?
  // Stored normalized (digits and a leading +) so the duplicate check in
  // createColdLead matches regardless of how the number was typed.
  phone        String
  whatsapp     String?
  source       ColdLeadSource @default(GOOGLE_MAPS)
  // Maps link, or who referred them.
  sourceDetail String?
  notes        String?

  status     ColdLeadStatus @default(NEW)
  // When to call/message next — a time, not just a date, since a callback
  // is usually "call me at 4".
  followUpAt DateTime?
  lastCalledAt DateTime?

  ownerId String
  owner   Employee @relation(fields: [ownerId], references: [id])

  convertedLeadId String? @unique

  logs ColdCallLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([followUpAt])
  @@index([phone])
}

/** One row per call (or "details sent" message) — the lead's timeline. */
model ColdCallLog {
  id         String         @id @default(cuid())
  coldLeadId String
  coldLead   ColdLead       @relation(fields: [coldLeadId], references: [id], onDelete: Cascade)
  callerId   String
  caller     Employee       @relation(fields: [callerId], references: [id])
  outcome    ColdLeadStatus
  notes      String?
  followUpAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([coldLeadId])
  @@index([callerId, createdAt])
}
